## Subgroup analysis by publication era -------------------------------------
sub <- list()
for (o in c("va", "vf", "icd", "death")) {
  d <- get_outcome(ivf, o)
  for (e in levels(ivf$era)) {
    de <- d[d$era == e, ]
    if (nrow(de) >= 2) sub[[length(sub) + 1]] <- summ(fit_prop(de), paste0(outcomes[o], " - ", e), de)
  }
  es  <- escalc("PFT", xi = xi, ni = ni, data = d, add = 0)
  mod <- rma(yi, vi, mods = ~ era, data = es, method = "REML")
  cat(sprintf("%s: test for subgroup difference QM(1) = %.2f, p = %.3f\n",
              outcomes[o], mod$QM, mod$QMp))
}
subgroups <- do.call(rbind, sub)
