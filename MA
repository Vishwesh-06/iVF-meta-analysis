  g <- rma.glmm(measure = "PLO", xi = xi, ni = ni, data = d)
  p <- predict(g, transf = transf.ilogit)
  sens[[length(sens) + 1]] <- data.frame(
    analysis = paste("GLMM (logit):", outcomes[o]), k = g$k,
    events = sum(d$xi), patients = sum(d$ni),
    pooled_pct = round(100 * p$pred, 1), ci_lb = round(100 * p$ci.lb, 1),
    ci_ub = round(100 * p$ci.ub, 1), pi_lb = round(100 * p$pi.lb, 1),
    pi_ub = round(100 * p$pi.ub, 1), I2 = round(g$I2, 1), tau2 = round(g$tau2, 4),
    Q = NA, Q_p = NA)
}

# Exclusion-based sensitivity analyses for each main outcome
excl_sets <- list(
  "Excluding studies with <10 patients"           = function(d) d[d$n_ivf >= 10, ],
  "Excluding treatment-modified cohorts"          = function(d) d[d$treat_mod == 0, ],
  "Strict recurrence definition (documented VF/VT or appropriate ICD therapy)" =
    function(d) d[d$broad_def == 0, ],
  "Excluding potentially overlapping cohorts"     = function(d) d[d$overlap == 0, ],
  "Excluding selected populations"                = function(d) d[d$selected == 0, ],
  "Prospective studies only"                      = function(d) d[d$prospective == 1, ],
  "Multicenter studies only"                      = function(d) d[d$multicenter == 1, ]
)
for (o in c("va", "icd", "death")) {
  for (nm in names(excl_sets)) {
    if (grepl("^Strict", nm) && o != "va") next     # definition applies to recurrence only
    d <- excl_sets[[nm]](get_outcome(ivf, o))
    if (nrow(d) < 3) next
    sens[[length(sens) + 1]] <- summ(fit_prop(d), paste0(nm, ": ", outcomes[o]), d)
  }
}
