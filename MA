## Meta-regression (recurrent VA) ------------------------------------------
es_va <- escalc("PFT", xi = xi, ni = ni, data = dva, add = 0)
mr_year <- rma(yi, vi, mods = ~ year, data = es_va, method = "REML")
mr_fu   <- rma(yi, vi, mods = ~ fu_y, data = es_va, method = "REML") 
print(mr_year); print(mr_fu)

# Small-sample safeguards: Knapp-Hartung adjustment + permutation test, plus a GLMM check
set.seed(2026)                                   # makes the permutation p-value reproducible
mr_rows <- list()
for (cov in c("fu_y", "year")) {
  f   <- as.formula(paste("~", cov))
  mkh <- rma(yi, vi, mods = f, data = es_va, method = "REML", test = "knha")
  mpm <- permutest(mkh, iter = 5000)
  mgl <- rma.glmm(measure = "PLO", xi = xi, ni = ni, mods = f, data = dva)
  mr_rows[[cov]] <- data.frame(
    covariate       = ifelse(cov == "fu_y", "Follow-up duration (y)", "Publication year"),
    k               = mkh$k,
    slope_FT_scale  = round(coef(mkh)[2], 4),
    p_knapp_hartung = round(mkh$pval[2], 3),
    p_permutation   = round(mpm$pval[2], 3),
    p_glmm          = round(mgl$pval[2], 3),
    R2_percent      = round(mkh$R2, 1))
}
metareg_table <- do.call(rbind, mr_rows)
print(metareg_table, row.names = FALSE)

save_fig("metareg_va_followup", width = 6.5, height = 5,
