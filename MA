## 8. Annualized event rates (approximate) -------------------------------------
# Person-years approximated as denominator x mean/median follow-up.
# Report as an approximation: true person-time is rarely published.
rate_res <- list()
for (o in c("va", "icd", "death")) {
  d <- get_outcome(ivf, o)
  d <- d[!is.na(d$fu_y), ]
  d$pt <- d$ni * d$fu_y
  g <- rma.glmm(measure = "IRLN", xi = xi, ti = pt, data = d)
  p <- predict(g, transf = exp)
  rate_res[[length(rate_res) + 1]] <- data.frame(
    outcome = outcomes[o], k = g$k, events = sum(d$xi), person_years = round(sum(d$pt)),
    rate_per_100py = round(100 * p$pred, 2),
    ci_lb = round(100 * p$ci.lb, 2), ci_ub = round(100 * p$ci.ub, 2))
}
rates <- do.call(rbind, rate_res)
print(rates)

