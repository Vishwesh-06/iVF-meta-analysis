# Long-term outcomes of idiopathic ventricular fibrillation (iVF)
# Primary model:
#   Freeman-Tukey double-arcsine transformed proportions, random effects, REML,
#   back-transformed with the harmonic mean of study sizes (Miller 1978).

# Sensitivity model: binomial-normal GLMM with logit link (rma.glmm).

# Sections
#   0. Setup
#   1. Data (from Table 1 / Table 2)
#   2. Helper functions
#   3. Primary analyses + forest plots
#   4. Cardiac death (descriptive, not pooled)
#   5. Sensitivity analyses (incl. strict recurrence definition, leave-one-out)
#   6. Subgroup analysis by publication era
#   7. Meta-regression (Knapp-Hartung + permutation test, GLMM check)
#   8. Annualized event rates (approximate person-years)
#   9. Small-study effects (funnel plot, Egger and sample-size-based tests)
#  10. Diagnostic reclassification during follow-up

## 0. Setup -------------------------------------------------------------------
> library(metafor)   # meta-analysis
> library(lme4)      # needed by rma.glmm() for the GLMM sensitivity analysis
> 
> out_dir <- "ivf_output"
> dir.create(out_dir, showWarnings = FALSE)

